# Postgres connection string (Neon). Create a project at https://neon.tech and
# paste the pooled connection string here (in .env.local, never committed).
DATABASE_URL=

# Session-cookie signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Email (password reset) — Gmail SMTP (chunk 9c; no domain needed) ---
# Your Gmail address. Emails arrive as "XXL Bet <this address>".
GMAIL_USER=
# A Google APP password (NOT your normal password): enable 2-Step Verification,
# then create one at https://myaccount.google.com/apppasswords (16 chars).
GMAIL_APP_PASSWORD=
# Both unset = dev fallback: reset links are logged to the server console.
# Public base URL used in reset links. Unset = http://localhost:3000.
APP_URL=
