# Postgres connection string (Neon). Create a project at https://neon.tech and
# paste the pooled connection string here (in .env.local, never committed).
DATABASE_URL=

# Session-cookie signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Email (password reset) — chunk 7 ---
# Resend API key (https://resend.com). Unset = dev fallback: emails are logged
# to the console instead of sent.
RESEND_API_KEY=
# Verified sender, e.g. "XXL Bet <bet@yourdomain.nl>". Unset = Resend sandbox
# sender (delivers only to the Resend account owner).
EMAIL_FROM=
# Public base URL used in reset links. Unset = http://localhost:3000.
APP_URL=
